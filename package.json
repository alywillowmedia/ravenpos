{
  "name": "ravenpos",
  "description": "RavenPOS desktop point-of-sale application",
  "private": true,
  "version": "3.8.14",
  "author": "Ravenlia",
  "repository": {
    "type": "git",
    "url": "https://github.com/alywillowmedia/ravenpos.git"
  },
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "stop": "lsof -ti:5173 | xargs kill",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "backup:db": "bash scripts/backup-supabase-local.sh",
    "images:optimize:sb": "node scripts/optimize-supabase-item-images.mjs",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run electron:build:base && npm run electron:build:installer:only && npm run electron:build:portable:only && npm run electron:verify:artifacts",
    "electron:build:base": "node scripts/verify-electron-env.cjs && tsc -b && vite build --mode electron",
    "electron:build:installer": "npm run electron:build:base && npm run electron:build:installer:only",
    "electron:build:installer:only": "electron-builder --win nsis --x64 --publish never",
    "electron:build:installer:publish": "electron-builder --win nsis --x64 --publish always",
    "electron:build:portable": "npm run electron:build:base && npm run electron:build:portable:only",
    "electron:build:portable:only": "electron-builder --win portable --x64 --publish never",
    "electron:release": "npm run electron:build:base && npm run electron:build:installer:publish",
    "electron:verify:artifacts": "node scripts/verify-electron-artifacts.cjs"
  },
  "dependencies": {
    "@radix-ui/react-hover-card": "^1.1.15",
    "@supabase/supabase-js": "^2.49.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.3",
    "jsbarcode": "^3.11.6",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.562.0",
    "motion": "^12.34.3",
    "node-thermal-printer": "^4.3.0",
    "papaparse": "^5.4.1",
    "qss": "^3.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "recharts": "^3.6.0",
    "stripe": "^20.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/papaparse": "^5.3.15",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "eslint": "^9.18.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.4",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.ravenlia.ravenpos",
    "productName": "RavenPOS",
    "directories": {
      "output": "electron-dist"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "RavenPOS-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "artifactName": "RavenPOS-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "RavenPOS-Portable-${version}-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "alywillowmedia",
        "repo": "ravenpos",
        "releaseType": "release"
      }
    ]
  }
}
